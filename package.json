{
  "name": "kasukretan-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,teal \"npm run dev:api\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false scripts/dev-api.ts",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "db:init": "tsx scripts/db-init.ts",
    "db:import": "tsx scripts/db-import.ts",
    "db:export": "tsx scripts/db-export.ts",
    "jwt:secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('base64url'))\""
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@libsql/client": "^0.15.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flatpickr": "^4.6.13",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.16.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
