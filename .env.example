# Salin ke .env.local untuk pengembangan lokal (jangan di-commit).
# Di Vercel: isi variabel yang sama di Project → Settings → Environment Variables.

# Lokal: file SQLite di folder data/ (tanpa akun Turso)
TURSO_DATABASE_URL=file:./data/kasukretan.db
TURSO_AUTH_TOKEN=

# Produksi (Turso):
# TURSO_DATABASE_URL=libsql://kasukretan-<nama-anda>.aws-ap-northeast-1.turso.io
# TURSO_AUTH_TOKEN=<token dari: turso db tokens create kasukretan>

# Minimal 32 karakter acak. Buat dengan: npm run jwt:secret
JWT_SECRET=

# Fonnte (opsional) — pengingat setor petugas via WhatsApp sekali klik
# Token dari dashboard Fonnte (device → token). Juga isi di Vercel → Environment Variables.
# FONNTE_TOKEN=
